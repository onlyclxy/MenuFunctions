<Window x:Class="MenuFunctions_Panel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MenuFunctions_Panel"
        mc:Ignorable="d"
        Title="右键菜单配置编辑器" Height="700" Width="1100" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 布尔值到可见性转换器 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- 反向布尔值到可见性转换器 -->
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        
        <!-- 非空判断转换器 -->
        <local:NotNullConverter x:Key="NotNullConverter"/>
        
        <!-- TreeView 样式 -->
        <HierarchicalDataTemplate x:Key="TreeViewTemplate" ItemsSource="{Binding SubItems}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Text}" Margin="0,0,5,0"/>
                <TextBlock Text="[分隔线]" Foreground="Gray" Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="[隐藏]" Foreground="Red" Visibility="{Binding IsVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>
    
    <DockPanel>
        <!-- 顶部工具栏 -->
        <ToolBarTray DockPanel.Dock="Top" Background="#F0F0F0">
            <ToolBar>
                <Button Click="LoadConfig_Click" ToolTip="打开配置文件">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="打开"/>
                    </StackPanel>
                </Button>
                <Button Click="SaveConfig_Click" ToolTip="保存配置文件">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="保存"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Click="AddMenuItem_Click" ToolTip="添加根菜单项">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="新增"/>
                    </StackPanel>
                </Button>
                <Button Click="AddSubMenuItem_Click" ToolTip="添加子菜单项">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📑" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="添加子项"/>
                    </StackPanel>
                </Button>
                <Button Click="AddSeparator_Click" ToolTip="添加分隔线">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➖" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="分隔线"/>
                    </StackPanel>
                </Button>
                <Button Click="DeleteMenuItem_Click" ToolTip="删除选中项">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="删除"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Click="MoveUp_Click" ToolTip="上移">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬆️" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="上移"/>
                    </StackPanel>
                </Button>
                <Button Click="MoveDown_Click" ToolTip="下移">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬇️" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="下移"/>
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- 底部状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="配置文件: "/>
                    <Run Text="{Binding ConfigFilePath, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- 主内容区域 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧菜单树 -->
            <GroupBox Grid.Column="0" Header="菜单结构" Margin="5">
                <TreeView x:Name="MenuTreeView" 
                          ItemsSource="{Binding MenuItems}"
                          ItemTemplate="{StaticResource TreeViewTemplate}"
                          SelectedItemChanged="MenuTreeView_SelectedItemChanged"/>
            </GroupBox>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

            <!-- 右侧配置面板 -->
            <GroupBox Grid.Column="2" Header="详细配置" Margin="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10" IsEnabled="{Binding SelectedItem, Converter={StaticResource NotNullConverter}}">
                        
                        <!-- 基本信息 -->
                        <Expander Header="📌 基本信息" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <Label Content="菜单文本:"/>
                                <TextBox Text="{Binding SelectedItem.Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                
                                <CheckBox Content="是否为分隔线" IsChecked="{Binding SelectedItem.IsSeparator}" Margin="0,0,0,10"/>
                                <CheckBox Content="是否可见" IsChecked="{Binding SelectedItem.IsVisible}" Margin="0,0,0,10"/>
                                
                                <Label Content="排序序号:"/>
                                <TextBox Text="{Binding SelectedItem.Order, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Expander>

                        <!-- 显示位置 -->
                        <Expander Header="📍 显示位置" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <CheckBox Content="显示在根菜单" IsChecked="{Binding SelectedItem.ShowInRootMenu}" Margin="0,0,0,5"/>
                                <CheckBox Content="显示在文件上" IsChecked="{Binding SelectedItem.ShowOnFiles}" Margin="0,0,0,5"/>
                                <CheckBox Content="显示在文件夹上" IsChecked="{Binding SelectedItem.ShowOnFolder}" Margin="0,0,0,5"/>
                                <CheckBox Content="显示在文件夹背景" IsChecked="{Binding SelectedItem.ShowOnFolderBackground}" Margin="0,0,0,5"/>
                            </StackPanel>
                        </Expander>

                        <!-- 程序设置 -->
                        <Expander Header="⚙️ 程序设置" IsExpanded="True" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <Label Content="程序路径:"/>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="浏览..." Click="BrowseProgram_Click" Width="60" Margin="5,0,0,0"/>
                                    <TextBox Text="{Binding SelectedItem.ProgramPath, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>

                                <Label Content="命令参数:"/>
                                <TextBox Text="{Binding SelectedItem.Command, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                <Label Content="图标路径:"/>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="浏览..." Click="BrowseIcon_Click" Width="60" Margin="5,0,0,0"/>
                                    <TextBox Text="{Binding SelectedItem.IconPath, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>
                        </Expander>

                        <!-- 文件类型过滤 -->
                        <Expander Header="📄 文件类型过滤" IsExpanded="False" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <Label Content="文件类型 (用逗号分隔，如: .txt, .doc):"/>
                                <TextBox Text="{Binding FileTypesText, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                                <TextBlock Text="留空表示适用于所有文件类型" Foreground="Gray" FontSize="10"/>
                            </StackPanel>
                        </Expander>

                        <!-- 高级选项 -->
                        <Expander Header="🔧 高级选项" IsExpanded="False" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <CheckBox Content="参数跟在每条路径后面" IsChecked="{Binding SelectedItem.AppendCommandToEachPath}" 
                                          ToolTip="如果选中，命令参数会附加到每个文件路径后；否则所有路径放在最后" Margin="0,0,0,5"/>
                                <CheckBox Content="路径使用引号" IsChecked="{Binding SelectedItem.UseQuotes}" 
                                          ToolTip="为文件路径添加双引号" Margin="0,0,0,5"/>
                                <CheckBox Content="只使用程序路径" IsChecked="{Binding SelectedItem.OnlyUsingProgram}" 
                                          ToolTip="不传递文件路径参数，只运行程序" Margin="0,0,0,5"/>
                                <CheckBox Content="添加文件类型参数" IsChecked="{Binding SelectedItem.AddFileTypeParameter}" 
                                          ToolTip="在参数末尾添加 &amp;file 或 &amp;folder 标识" Margin="0,0,0,5"/>
                                <CheckBox Content="显示完整路径和命令（调试用）" IsChecked="{Binding SelectedItem.DisplayCompletePathAndCommand}" 
                                          ToolTip="执行前弹窗显示完整命令，用于调试" Margin="0,0,0,5"/>
                            </StackPanel>
                        </Expander>

                        <!-- CMD 设置 -->
                        <Expander Header="💻 CMD 设置" IsExpanded="False" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <CheckBox Content="通过 CMD 运行程序" IsChecked="{Binding SelectedItem.RunningProgramWithCMD}" 
                                          ToolTip="使用 cmd.exe 执行命令" Margin="0,0,0,5"/>
                                <CheckBox Content="隐藏 CMD 窗口" IsChecked="{Binding SelectedItem.HideCmdWindow}" 
                                          ToolTip="不显示命令行窗口" Margin="0,0,0,5"
                                          IsEnabled="{Binding SelectedItem.RunningProgramWithCMD}"/>
                                <CheckBox Content="保持 CMD 窗口打开" IsChecked="{Binding SelectedItem.KeepCmdWindows}" 
                                          ToolTip="使用 /K 参数，命令执行后保持窗口" Margin="0,0,0,5"
                                          IsEnabled="{Binding SelectedItem.RunningProgramWithCMD}"/>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
    </Grid>
    </DockPanel>
</Window>
