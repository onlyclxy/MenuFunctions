<UserControl x:Class="MenuFunctions_Panel.Controls.FileBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="280">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="📁 文件浏览器" FontWeight="Bold" FontSize="13" 
                           Foreground="#333333" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="🔄" Click="Refresh_Click" 
                        Width="30" Height="24" ToolTip="刷新" Margin="2,0"/>
                <Button DockPanel.Dock="Right" Content="⬆️" Click="GoUp_Click" 
                        Width="30" Height="24" ToolTip="上一级" Margin="2,0,8,0"/>
            </DockPanel>
        </Border>
        
        <!-- 地址栏 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="转到" Click="Navigate_Click" 
                        Width="50" Height="24" Margin="4,0,0,0"/>
                <TextBox x:Name="AddressBar" Padding="6,4" BorderBrush="#CCCCCC" 
                         KeyDown="AddressBar_KeyDown" VerticalContentAlignment="Center"/>
            </DockPanel>
        </Border>
        
        <!-- 快捷按钮栏 -->
        <StackPanel DockPanel.Dock="Top" Background="#FAFAFA" Margin="5">
            <Button Click="ClearSelection_Click" HorizontalAlignment="Stretch" Height="30" Margin="0,0,0,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="❌" FontSize="14" Margin="0,0,5,0"/>
                    <TextBlock Text="取消选择" FontSize="12"/>
                </StackPanel>
            </Button>
            <Separator Margin="0,4"/>
            <Button Click="SelectDesktop_Click" HorizontalAlignment="Stretch" Height="30" Margin="0,0,0,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🖥️" FontSize="14" Margin="0,0,5,0"/>
                    <TextBlock Text="桌面" FontSize="12"/>
                </StackPanel>
            </Button>
            <Button Click="SelectDocuments_Click" HorizontalAlignment="Stretch" Height="30" Margin="0,0,0,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📄" FontSize="14" Margin="0,0,5,0"/>
                    <TextBlock Text="我的文档" FontSize="12"/>
                </StackPanel>
            </Button>
            <Button Click="SelectDownloads_Click" HorizontalAlignment="Stretch" Height="30">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⬇️" FontSize="14" Margin="0,0,5,0"/>
                    <TextBlock Text="下载" FontSize="12"/>
                </StackPanel>
            </Button>
        </StackPanel>
        
        <!-- Windows Forms TreeView -->
        <wfi:WindowsFormsHost x:Name="TreeViewHost">
            <wf:TreeView x:Name="FileTreeView" 
                        AfterSelect="FileTreeView_AfterSelect"
                        BeforeExpand="FileTreeView_BeforeExpand"
                        NodeMouseDoubleClick="FileTreeView_NodeMouseDoubleClick"
                        ShowLines="True"
                        ShowRootLines="True"
                        ShowPlusMinus="True"
                        Dock="Fill"/>
        </wfi:WindowsFormsHost>
    </DockPanel>
</UserControl>
